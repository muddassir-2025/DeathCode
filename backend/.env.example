# ---------------------------------------------------------------------------
# Death Code API configuration
#
# Copy this file to `backend/.env` and fill in the values. `.env` is gitignored.
# These credentials belong to the SERVER only — never ship them inside the
# Android application.
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string.
# Neon console -> Connection details -> copy the "postgresql://..." URI
# (keep the ?sslmode=require suffix).
DB_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/deathcode?sslmode=require

# Secret used to sign community login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a community login stays valid.
JWT_EXPIRES_IN=30d

# Bootstrap administrator. On first start the server creates (or promotes) this account.
# Leave both empty to disable admin bootstrapping.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Render sets PORT automatically.
PORT=8080

# Comma separated allowed browser origins, or * for any.
CORS_ORIGINS=*

# --- Rate limits (server enforced) -----------------------------------------
RATE_LIMIT_GLOBAL_PER_MINUTE=180
RATE_LIMIT_AUTH_PER_WINDOW=12
RATE_LIMIT_SUBMISSIONS_PER_HOUR=5
RATE_LIMIT_SUBMISSIONS_PER_DAY=20
RATE_LIMIT_MAX_PENDING=10

# --- Payload limits --------------------------------------------------------
MAX_MARKDOWN_CHARS=200000
MAX_PACKAGE_NODES=5000
MAX_BODY_SIZE=2mb
